# Third-party libraries, fetched at pinned versions (nothing is vendored) and marked SYSTEM so the
# project's warnings never fire on their headers. Included once from the top-level CMakeLists.txt.
#
# Targets:
#   glm::glm           math
#   glad_gl_core_45    GL 4.5 core loader (generated by glad2, or the pre-generated fallback)
#   glfw               windowing, X11 only on Linux; used by apps/demo and tests/render
#   imgui_core         Dear ImGui core plus the OpenGL3 backend; used by viewer
#   imgui_glfw         Dear ImGui GLFW backend; used by hosts only
#   stb                header-only PNG reader and writer; used by tests/render

include(FetchContent)

# ---------------------------------------------------------------------------- glm

set(GLM_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(GLM_BUILD_INSTALL OFF CACHE BOOL "" FORCE)
FetchContent_Declare(
  glm
  URL https://github.com/g-truc/glm/archive/refs/tags/1.0.3.tar.gz
  DOWNLOAD_EXTRACT_TIMESTAMP TRUE
  SYSTEM
)

# ---------------------------------------------------------------------------- GLFW
# X11 only: Wayland support needs more build dependencies, and XWayland covers Wayland desktops.

set(GLFW_BUILD_WAYLAND OFF CACHE BOOL "" FORCE)
set(GLFW_BUILD_X11 ON CACHE BOOL "" FORCE)
set(GLFW_BUILD_DOCS OFF CACHE BOOL "" FORCE)
set(GLFW_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(GLFW_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(GLFW_INSTALL OFF CACHE BOOL "" FORCE)
FetchContent_Declare(
  glfw
  URL https://github.com/glfw/glfw/archive/refs/tags/3.5.1.tar.gz
  DOWNLOAD_EXTRACT_TIMESTAMP TRUE
  SYSTEM
)

FetchContent_MakeAvailable(glm glfw)

# Plain x, y, z, w members instead of unions aliasing them as r, g, b, a and s, t, p, q: reading
# an alias of the member last written is undefined behaviour in C++, and every access through a
# union trips cppcoreguidelines-pro-type-union-access.
target_compile_definitions(glm INTERFACE GLM_FORCE_XYZW_ONLY)

# Consumers get glad's GL declarations, never GLFW's own GL header.
target_compile_definitions(glfw INTERFACE GLFW_INCLUDE_NONE)

# Under AddressSanitizer on Linux: GLFW loads libX11 and libGL with dlopen and unloads them in
# glfwTerminate, before LeakSanitizer scans at exit. Memory those libraries keep in their own
# globals then looks leaked, with unsymbolised stacks. Linking them keeps them mapped, so
# LeakSanitizer sees that memory as reachable and still reports real leaks.
if(ENABLE_ASAN AND UNIX AND NOT APPLE)
  find_package(X11 REQUIRED)
  find_package(OpenGL REQUIRED)
  target_link_libraries(glfw INTERFACE X11::X11 OpenGL::GL)
  target_link_options(glfw INTERFACE LINKER:--no-as-needed)
endif()

# ---------------------------------------------------------------------------- glad2
# The loader is generated at configure time, so its header exists before anything is built (the
# lint job only configures). That needs Python with jinja2. Where that is not available, generate
# it once on the glad2 web generator (gl 4.5, core profile) and unpack it into
# third_party/glad-generated/ (git-ignored); that folder is used first when it exists.

set(GL_ENGINE_GLAD_FALLBACK_DIR "${PROJECT_SOURCE_DIR}/third_party/glad-generated")

if(EXISTS "${GL_ENGINE_GLAD_FALLBACK_DIR}/src/gl.c")
  message(STATUS "glad: using the pre-generated loader in ${GL_ENGINE_GLAD_FALLBACK_DIR}")
  set(_glad_dir "${GL_ENGINE_GLAD_FALLBACK_DIR}")
else()
  find_package(Python3 COMPONENTS Interpreter)
  set(_glad_python_ok FALSE)
  if(Python3_Interpreter_FOUND)
    execute_process(
      COMMAND "${Python3_EXECUTABLE}" -c "import jinja2"
      RESULT_VARIABLE _glad_jinja2_result
      OUTPUT_QUIET ERROR_QUIET
    )
    if(_glad_jinja2_result EQUAL 0)
      set(_glad_python_ok TRUE)
    endif()
  endif()
  if(NOT _glad_python_ok)
    message(FATAL_ERROR
      "glad2 generates the GL loader at configure time and needs Python 3 with jinja2 "
      "(pip install jinja2). Alternatively, generate the loader on the glad2 web generator "
      "(gl 4.5, core profile) and unpack it into ${GL_ENGINE_GLAD_FALLBACK_DIR}, so that "
      "src/gl.c and include/glad/gl.h exist.")
  endif()

  # The generator is run directly rather than through glad_add_library(): that runs it at build
  # time, with whichever interpreter find_package(Python) picks, not the one checked for jinja2.
  FetchContent_Declare(
    glad
    URL https://github.com/Dav1dde/glad/archive/refs/tags/v2.0.8.tar.gz
    DOWNLOAD_EXTRACT_TIMESTAMP TRUE
    SOURCE_SUBDIR cmake
  )
  FetchContent_MakeAvailable(glad)

  set(_glad_dir "${CMAKE_BINARY_DIR}/glad")
  set(_glad_args --out-path "${_glad_dir}" --api gl:core=4.5 --reproducible c)
  set(_glad_stamp "${_glad_dir}/args.txt")
  if(EXISTS "${_glad_stamp}")
    file(READ "${_glad_stamp}" _glad_previous_args)
  endif()
  if(NOT EXISTS "${_glad_dir}/src/gl.c" OR NOT _glad_previous_args STREQUAL "${_glad_args}")
    message(STATUS "glad: generating the GL 4.5 core loader")
    file(REMOVE_RECURSE "${_glad_dir}")
    execute_process(
      COMMAND "${Python3_EXECUTABLE}" -m glad ${_glad_args}
      WORKING_DIRECTORY "${glad_SOURCE_DIR}"
      RESULT_VARIABLE _glad_result
    )
    if(NOT _glad_result EQUAL 0)
      message(FATAL_ERROR "glad: generating the GL loader failed")
    endif()
    file(WRITE "${_glad_stamp}" "${_glad_args}")
  endif()
endif()

add_library(glad_gl_core_45 STATIC "${_glad_dir}/src/gl.c")
target_include_directories(glad_gl_core_45 SYSTEM PUBLIC "${_glad_dir}/include")

# Keep the C dependencies out of compile_commands.json. clang-tidy checks a header by borrowing
# the compile command of the most similarly named file, and a header such as input.h would
# otherwise get GLFW's input.c command and be parsed as C.
set_target_properties(glfw glad_gl_core_45 PROPERTIES EXPORT_COMPILE_COMMANDS OFF)

# ---------------------------------------------------------------------------- Dear ImGui
# ImGui ships no CMake build; the two targets are defined here. The OpenGL3 backend brings its own
# small GL loader, so imgui_core does not depend on glad.

FetchContent_Declare(
  imgui
  URL https://github.com/ocornut/imgui/archive/refs/tags/v1.93.0.tar.gz
  DOWNLOAD_EXTRACT_TIMESTAMP TRUE
  SYSTEM
)
FetchContent_MakeAvailable(imgui)

add_library(imgui_core STATIC
  "${imgui_SOURCE_DIR}/imgui.cpp"
  "${imgui_SOURCE_DIR}/imgui_draw.cpp"
  "${imgui_SOURCE_DIR}/imgui_tables.cpp"
  "${imgui_SOURCE_DIR}/imgui_widgets.cpp"
  "${imgui_SOURCE_DIR}/backends/imgui_impl_opengl3.cpp"
)
target_include_directories(imgui_core SYSTEM PUBLIC "${imgui_SOURCE_DIR}" "${imgui_SOURCE_DIR}/backends")

add_library(imgui_glfw STATIC "${imgui_SOURCE_DIR}/backends/imgui_impl_glfw.cpp")
target_link_libraries(imgui_glfw PUBLIC imgui_core glfw)

# ---------------------------------------------------------------------------- stb
# stb has no releases; pinned by commit. Only stb_image and stb_image_write are used.

FetchContent_Declare(
  stb
  URL https://github.com/nothings/stb/archive/003501f6d7a8668ce8b6d875e34dd97ad0d5d5b5.tar.gz
  DOWNLOAD_EXTRACT_TIMESTAMP TRUE
  SYSTEM
)
FetchContent_MakeAvailable(stb)

add_library(stb INTERFACE)
target_include_directories(stb SYSTEM INTERFACE "${stb_SOURCE_DIR}")
