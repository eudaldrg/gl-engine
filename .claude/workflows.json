{
  "cpp": {
    "enabled": true,
    "repo": {
      "ci": {
        "aptPackages": [
          "libx11-dev",
          "libxrandr-dev",
          "libxinerama-dev",
          "libxcursor-dev",
          "libxi-dev",
          "libgl-dev",
          "xvfb",
          "mesa-utils",
          "libgl1-mesa-dri"
        ],
        "pipPackages": [
          "jinja2"
        ],
        "env": {
          "LIBGL_ALWAYS_SOFTWARE": "1"
        },
        "testWrapper": "xvfb-run -a"
      }
    }
  },
  "git": {
    "protectedBranches+": [
      "dev"
    ]
  }
}
